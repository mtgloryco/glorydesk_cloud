# GloryDesk Cloud Environment Configuration

# Server Port (default: 8080)
PORT=8080

# Environment
ASPNETCORE_ENVIRONMENT=Production

# Database:
# Leave empty to use embedded SQLite (cloud.db)
# Or set PostgreSQL connection string (Railway, Supabase, Neon, Docker Postgres):
# postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres_secret@db:5432/glorydesk_cloud

# JWT Secret (MUST be at least 32 characters long in production)
Jwt__Key=IMS-Cloud-Dev-Secret-Key-Change-In-Production-32chars!
Jwt__Issuer=glorydesk-web
Jwt__Audience=glorydesk-clients

# Admin Security
# Passed via 'X-Admin-Key' HTTP header for administrative endpoints
Admin__ApiKey=change-me-in-production
Admin__AlertEmail=support@mtglory.com

# Licensing (Optional, base64-encoded PKCS#8 RSA private key for signing licenses)
License__PrivateKeyBase64=

# Backup Storage Directory (default: backups)
BackupStoragePath=backups

# SMTP Settings (Optional, for email alerts and sending license keys)
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=noreply@mtglory.com
Smtp__EnableSsl=true

# Downloads & Public Info
Downloads__WindowsInstallerFile=GloryDesk_Setup_v1.0.1_Windows.exe
Downloads__WindowsVersion=1.0.1
Downloads__WindowsSizeMb=102
Downloads__GitHubReleaseUrl=https://github.com/mtgloryco/glorydesk/releases/latest
